{
  "$defs": {
    "FieldDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FieldKind"
        },
        "nullable": {
          "default": true,
          "title": "Nullable",
          "type": "boolean"
        },
        "confidential": {
          "default": false,
          "title": "Confidential",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "title": "FieldDefinition",
      "type": "object"
    },
    "FieldKind": {
      "enum": [
        "text",
        "number",
        "boolean",
        "date",
        "datetime"
      ],
      "title": "FieldKind",
      "type": "string"
    },
    "FieldMapping": {
      "additionalProperties": false,
      "properties": {
        "source_field": {
          "minLength": 1,
          "title": "Source Field",
          "type": "string"
        },
        "target_field": {
          "minLength": 1,
          "title": "Target Field",
          "type": "string"
        },
        "approved": {
          "default": false,
          "title": "Approved",
          "type": "boolean"
        }
      },
      "required": [
        "source_field",
        "target_field"
      ],
      "title": "FieldMapping",
      "type": "object"
    },
    "FilterSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "multiple": {
          "default": false,
          "title": "Multiple",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "field"
      ],
      "title": "FilterSpec",
      "type": "object"
    },
    "LayoutSpec": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "default": 12,
          "maximum": 24,
          "minimum": 1,
          "title": "Columns",
          "type": "integer"
        },
        "row_height": {
          "default": 80,
          "maximum": 400,
          "minimum": 20,
          "title": "Row Height",
          "type": "integer"
        },
        "positions": {
          "additionalProperties": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Positions",
          "type": "object"
        }
      },
      "title": "LayoutSpec",
      "type": "object"
    },
    "LocalizationSpec": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "pattern": "^(en|pt)(-[A-Z]{2})?$",
          "title": "Language",
          "type": "string"
        },
        "locale": {
          "minLength": 2,
          "title": "Locale",
          "type": "string"
        },
        "timezone": {
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 3,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "date_format": {
          "default": "YYYY-MM-DD",
          "minLength": 1,
          "title": "Date Format",
          "type": "string"
        },
        "number_format": {
          "default": "1,234.56",
          "minLength": 1,
          "title": "Number Format",
          "type": "string"
        }
      },
      "required": [
        "language",
        "locale",
        "timezone"
      ],
      "title": "LocalizationSpec",
      "type": "object"
    },
    "MetricDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "operation": {
          "pattern": "^(count|sum|average|ratio)$",
          "title": "Operation",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "numerator_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Field"
        },
        "denominator_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Field"
        },
        "group_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group By"
        },
        "filters": {
          "additionalProperties": true,
          "title": "Filters",
          "type": "object"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "approved": {
          "default": false,
          "title": "Approved",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "operation",
        "explanation"
      ],
      "title": "MetricDefinition",
      "type": "object"
    },
    "OutputKind": {
      "enum": [
        "web",
        "xlsx",
        "pdf"
      ],
      "title": "OutputKind",
      "type": "string"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "items": {
            "$ref": "#/$defs/OutputKind"
          },
          "minItems": 1,
          "title": "Enabled",
          "type": "array"
        },
        "excel_sheet_names": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Excel Sheet Names",
          "type": "object"
        },
        "pdf_page_size": {
          "default": "A4",
          "title": "Pdf Page Size",
          "type": "string"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "PrivacyPolicy": {
      "additionalProperties": false,
      "properties": {
        "confidential_fields": {
          "items": {
            "type": "string"
          },
          "title": "Confidential Fields",
          "type": "array"
        },
        "allow_temporary_display": {
          "default": false,
          "title": "Allow Temporary Display",
          "type": "boolean"
        },
        "allow_persistence": {
          "default": true,
          "title": "Allow Persistence",
          "type": "boolean"
        },
        "redact_logs": {
          "default": true,
          "title": "Redact Logs",
          "type": "boolean"
        }
      },
      "title": "PrivacyPolicy",
      "type": "object"
    },
    "SectionKind": {
      "enum": [
        "summary",
        "metrics",
        "chart",
        "table",
        "insights"
      ],
      "title": "SectionKind",
      "type": "string"
    },
    "SectionSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SectionKind"
        },
        "visualization_ids": {
          "items": {
            "type": "string"
          },
          "title": "Visualization Ids",
          "type": "array"
        },
        "field_ids": {
          "items": {
            "type": "string"
          },
          "title": "Field Ids",
          "type": "array"
        },
        "metric_ids": {
          "items": {
            "type": "string"
          },
          "title": "Metric Ids",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "order"
      ],
      "title": "SectionSpec",
      "type": "object"
    },
    "VisualizationKind": {
      "enum": [
        "card",
        "table",
        "bar",
        "line",
        "area",
        "pie",
        "donut",
        "funnel"
      ],
      "title": "VisualizationKind",
      "type": "string"
    },
    "VisualizationSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/VisualizationKind"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "metric_ids": {
          "items": {
            "type": "string"
          },
          "title": "Metric Ids",
          "type": "array"
        },
        "dimension_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension Field"
        },
        "value_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Field"
        },
        "options": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "title"
      ],
      "title": "VisualizationSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The only approved input accepted by web, Excel, and PDF renderers.",
  "properties": {
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldDefinition"
      },
      "title": "Fields",
      "type": "array"
    },
    "mappings": {
      "items": {
        "$ref": "#/$defs/FieldMapping"
      },
      "title": "Mappings",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricDefinition"
      },
      "title": "Metrics",
      "type": "array"
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/FilterSpec"
      },
      "title": "Filters",
      "type": "array"
    },
    "visualizations": {
      "items": {
        "$ref": "#/$defs/VisualizationSpec"
      },
      "title": "Visualizations",
      "type": "array"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/SectionSpec"
      },
      "title": "Sections",
      "type": "array"
    },
    "layout": {
      "$ref": "#/$defs/LayoutSpec"
    },
    "terminology": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Terminology",
      "type": "object"
    },
    "localization": {
      "$ref": "#/$defs/LocalizationSpec"
    },
    "privacy": {
      "$ref": "#/$defs/PrivacyPolicy"
    },
    "outputs": {
      "$ref": "#/$defs/OutputSpec"
    }
  },
  "required": [
    "id",
    "title",
    "fields",
    "mappings",
    "metrics",
    "sections",
    "localization",
    "outputs"
  ],
  "title": "DashboardSpec",
  "type": "object"
}
